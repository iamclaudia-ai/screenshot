{
  "name": "@iamclaudia/screenshot",
  "version": "0.3.0",
  "description": "Generate screenshots from HTML files using Playwright",
  "type": "module",
  "bin": {
    "screenshot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "bun test",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "screenshot",
    "html",
    "playwright",
    "cli",
    "image-generation"
  ],
  "author": "iamclaudia-ai <claudia@iamclaudia.ai> (https://iamclaudia.ai)",
  "license": "MIT",
  "dependencies": {
    "playwright": "~1.65.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "contributors": [
    "Michael Carter"
  ],
  "homepage": "https://github.com/iamclaudia-ai/screenshot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamclaudia-ai/screenshot.git"
  },
  "bugs": {
    "url": "https://github.com/iamclaudia-ai/screenshot/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
