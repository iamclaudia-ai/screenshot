{
  "name": "@iamclaudia/screenshot",
  "version": "0.3.0",
  "description": "Generate screenshots from HTML files using Playwright",
  "type": "module",
  "bin": {
    "screenshot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "screenshot",
    "html",
    "playwright",
    "cli",
    "image-generation"
  ],
  "author": "iamclaudia-ai <claudia@iamclaudia.ai> (https://iamclaudia.ai)",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "contributors": [
    "Michael Carter"
  ],
  "homepage": "https://github.com/iamclaudia-ai/screenshot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamclaudia-ai/screenshot.git"
  },
  "bugs": {
    "url": "https://github.com/iamclaudia-ai/screenshot/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
